# URL base de la API de EventPro (incluye el prefijo /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Número del chatbot de WhatsApp en formato internacional, sin «+» ni espacios.
# Mientras no esté definido, la landing muestra el CTA de WhatsApp inerte.
# NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999
